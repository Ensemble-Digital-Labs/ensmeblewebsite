{
  "name": "premium-marketing-agency",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "images:webp": "node scripts/generate-webp.mjs",
    "images:webp:force": "node scripts/generate-webp.mjs --force",
    "mirror:lamalama": "node scripts/mirror-lamalama-site.mjs",
    "mirror:lamalama:pages": "node scripts/mirror-lamalama-site.mjs --pages-only",
    "clean:local": "node -e \"const fs=require('fs');const p='dist';if(fs.existsSync(p))fs.rmSync(p,{recursive:true,force:true});const m='public/lamalama-mirror';if(fs.existsSync(m))for(const f of fs.readdirSync(m))if(!['.gitkeep','manifest.json'].includes(f))fs.rmSync(m+'/'+f,{recursive:true,force:true});console.log('clean:local done (dist + lamalama-mirror cache)')\""
  },
  "dependencies": {
    "@theatre/core": "^0.7.2",
    "@theatre/r3f": "^0.7.2",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.12.5",
    "hls.js": "^1.6.16",
    "locomotive-scroll": "^5.0.1",
    "lucide-react": "^0.577.0",
    "pixi.js": "^7.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.13.0",
    "swiper": "^12.1.1",
    "three": "^0.161.0",
    "tsparticles": "^3.9.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.0"
  }
}
