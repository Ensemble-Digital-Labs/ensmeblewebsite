# Copy to `.env` for local-only variables (do not commit real secrets).

# Set to `true` to use native #main scrolling in dev/preview (helps mouse wheel in DevTools
# responsive mode above 1024px where Lenis can ignore the wheel). Restart Vite after changing.
# VITE_USE_NATIVE_MAIN_SCROLL=true

# Contact page form → n8n webhook (defaults to production URL if unset)
# VITE_CONTACT_FORM_WEBHOOK_URL=https://n8n-automation.techsoit.com/webhook/contactForm
